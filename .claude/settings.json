{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": ["PowerShell(npm run lint)", "PowerShell(npm run format:check)"],
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },

  "hooks": {
    "FileChanged": [
      {
        "matcher": "test.js",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Add-Content -Path \"$env:TEMP\\claude-filechanged-hook.log\" -Value \"FileChanged fired: $(Get-Date -Format o)\""
          }
        ]
      }
    ]
  }
}
