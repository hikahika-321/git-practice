{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": ["PowerShell(npm run lint)", "PowerShell(npm run format:check)"],
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *)",

      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited-js.ps1"
            ]
          }
        ]
      }
    ]
  }
}
